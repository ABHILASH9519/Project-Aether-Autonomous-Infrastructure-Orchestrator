{
  "uid": "aether-http",
  "title": "AETHER / HTTP operations",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "aether",
    "local"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job) (rate(aether_http_requests_total[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Server errors / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job) (rate(aether_http_requests_total{status_class=\"5xx\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Average latency (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(rate(aether_http_request_duration_seconds_total[5m])) / clamp_min(sum by(job)(rate(aether_http_requests_total[5m])), 0.000001)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight requests",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(aether_http_inflight_requests)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending durable work",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(aether_outbox_pending)",
          "legendFormat": "outbox"
        },
        {
          "refId": "B",
          "expr": "max(aether_remediation_pending)",
          "legendFormat": "remediation"
        }
      ]
    },
    {
      "id": 6,
      "title": "Oldest unpublished event (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "aether-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(aether_outbox_oldest_seconds)",
          "legendFormat": "oldest outbox"
        }
      ]
    }
  ]
}
