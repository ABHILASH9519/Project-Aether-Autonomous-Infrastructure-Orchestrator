{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Never",
            "IfNotPresent",
            "Always"
          ]
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingest",
        "consumer",
        "relay",
        "workflow",
        "executor"
      ],
      "properties": {
        "ingest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "consumer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "relay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "workflow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "executor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "bundled"
      ],
      "properties": {
        "bundled": {
          "type": "boolean"
        }
      }
    }
  }
}
